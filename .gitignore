# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent skills: SKILL.md sources are tracked (shared); local caches/locks aren't
/.agents/
/skills-lock.json

# Locally-installed agent skills (not part of the app)
.agents/
.claude/skills/higgsfield-generate
.claude/skills/higgsfield-marketplace-cards
.claude/skills/higgsfield-product-photoshoot
.claude/skills/higgsfield-soul-id
