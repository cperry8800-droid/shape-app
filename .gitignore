# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# mobile /m/ bundle — built at deploy time from mobile-app/ (scripts/build-m.sh),
# no longer committed. Local /m/ preview: build it with
#   cd mobile-app && VITE_BASE=/m/ npm run build && cd .. && rm -rf public/m && cp -r mobile-app/dist public/m
/public/m

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# secrets / service-account credentials — NEVER commit these
# (Firebase Admin SDK JSON, Apple Music/APNs .p8, generic service-account keys)
*firebase-adminsdk*
*-adminsdk-*.json
serviceAccount*.json
*service-account*.json
*.p8
*.key
gha-creds-*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent skills: SKILL.md sources are tracked (shared); local caches/locks aren't
/.agents/
/skills-lock.json

# Locally-installed agent skills (not part of the app)
.agents/
# Transient subagent worktrees (isolated checkouts — never part of the app)
.claude/worktrees/
.claude/skills/higgsfield-generate
.claude/skills/higgsfield-marketplace-cards
.claude/skills/higgsfield-product-photoshoot
.claude/skills/higgsfield-soul-id

# Deploy-time newdesign JSX precompile output (scripts/build-newdesign.mjs)
/public/newdesign/nd
