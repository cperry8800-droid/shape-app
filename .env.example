# Copy this file to .env.local (for local dev) and also set each value as
# an Environment Variable in your Vercel project settings (for prod).
#
# NEXT_PUBLIC_* are exposed to the browser bundle. Everything else is
# server-only and must NEVER be prefixed with NEXT_PUBLIC_.

# ─── Supabase ────────────────────────────────────────────────────────
# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Project Settings → API → anon / public key (safe to expose)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Project Settings → API → service_role key (NEVER expose; used by the
# Stripe webhook to bypass RLS when writing subscription rows).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Stripe ──────────────────────────────────────────────────────────
# Developers → API keys → Secret key. Use sk_test_* for dev, sk_live_* in prod.
STRIPE_SECRET_KEY=sk_test_...

# Developers → Webhooks → your endpoint → Signing secret.
# For local dev, use `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# and copy the `whsec_...` it prints.
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Site ────────────────────────────────────────────────────────────
# Public origin of your site. Used in auth email redirects and Stripe
# checkout success/cancel URLs. Do NOT include a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rate limiting (optional). Secret used to HMAC the rate-limit bucket keys so the
# public check_rate_limit RPC can't be called directly with a guessed key to
# grief a user's counter. Any long random string. If unset, the limiter falls
# back to SUPABASE_SERVICE_ROLE_KEY as HMAC material (so it's hardened in prod by
# default); set this to decouple the two.
RATE_LIMIT_SECRET=

# Admin/application notifications. Coach applications are sent here.
APPLICATIONS_EMAIL=christopher.perry@theshapecommunity.com

# Comma-separated website admin emails allowed to review applications.
ADMIN_EMAILS=christopher.perry@theshapecommunity.com,cperry8800@gmail.com

# ─── hCaptcha (optional) ─────────────────────────────────────────────
# Uncomment and fill if you enable CAPTCHA protection in Supabase Auth
# settings. Without this var the phone login page skips the widget.
# NEXT_PUBLIC_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001

# â”€â”€â”€ Third-party integrations â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# OpenAI — powers AI plan drafts + the in-app Support assistant. Without a key,
# those fall back to templates / rule-based replies. OPENAI_MODEL is optional.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini

# Spotify Developer Dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Strava API Settings
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# WHOOP Developer Dashboard. Uses OAuth scopes configured in
# src/lib/integrations/providers.ts.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Oura Ring (API v2). Create an app at https://cloud.ouraring.com/oauth/applications
# and register the redirect URI <site>/api/integrations/oura/callback.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Garmin Health API credentials. Garmin access requires approval through
# the Garmin Connect Developer Program before production data will sync.
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=

# Apple Music / MusicKit. Generate a MusicKit private key in Apple Developer.
# Store the .p8 with escaped newlines in Vercel, e.g. -----BEGIN PRIVATE KEY-----\n...
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=

# Instacart Developer Platform (IDP). API key from the Instacart Connect
# dashboard. INSTACART_CONNECT_URL defaults to production; set it to
# https://connect.dev.instacart.tools to use the development catalog.
INSTACART_API_KEY=
INSTACART_CONNECT_URL=https://connect.instacart.com

# Error tracking (Layer 1). ALL OPTIONAL — absent means the SDK is disabled, which is
# the supported state until the Sentry org exists. Nothing fails without them.
#
# ⚠ THREE runtimes, THREE separate DSNs — Next.js, Capacitor and the browser are three
# different SDKs with three different release streams, so one DSN cannot serve all of
# them. Setting only the two Next.js ones leaves /m/ permanently inert with no signal
# anywhere that it is: a disabled SDK and a healthy one look identical from outside.
# Next.js server + edge runtimes.
SENTRY_DSN=
# Next.js browser bundle (baked in at build time).
NEXT_PUBLIC_SENTRY_DSN=
# The /m/ Capacitor mobile app (mobile-app/, baked in by Vite via scripts/build-m.sh).
VITE_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
