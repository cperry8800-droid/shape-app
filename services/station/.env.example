# Shape Radio's station (README.md). Copy to .env and fill in. Never commit .env.

# The station's public name: a DNS A record pointing at this machine.
STATION_HOST=radio.theshapecommunity.com

# Two different passwords, letters and digits only. Make each with:  openssl rand -hex 24
ICECAST_SOURCE_PASSWORD=
ICECAST_ADMIN_PASSWORD=

# The same value as NORA_ENGINE_TOKEN in the Shape project on Vercel.
NORA_ENGINE_TOKEN=

# Optional
# SHAPE_URL=https://www.theshapecommunity.com
# NORA_BITRATE=192k
# ICECAST_MAX_LISTENERS=2000
# ICECAST_ADMIN_EMAIL=radio@theshapecommunity.com
# STANDBY_FILE=/standby/standby.mp3
