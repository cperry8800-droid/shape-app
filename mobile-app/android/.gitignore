# Using Android gitignore template: https://github.com/github/gitignore/blob/HEAD/Android.gitignore

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
#  Uncomment the following line in case you need and you don't have the release build type files in your app
# release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
# Android Studio 3 in .gitignore file.
.idea/caches
.idea/modules.xml
# Comment next line if keeping position of elements in Navigation Editor is relevant for you
.idea/navEditor.xml

# Keystore files
# Uncomment the following lines if you do not want to check your keystore files in.
#*.jks
#*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
# google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/

# Android Profiling
*.hprof

# Cordova plugins for Capacitor — INTENTIONALLY tracked so the Android
# Studio Gradle sync works for devs without Node installed (the directory
# is regenerated by `npx cap sync android`).
# capacitor-cordova-android-plugins

# Copied web assets — cap-sync OUTPUT, deliberately NOT tracked (2026-07-25).
#
# These were tracked on purpose (#471, 2026-05-27) so an Android Studio build
# would "always pick up the latest synced bundle" without running Node. That
# guarantee did not survive contact: by 2026-07-25 the committed bundle was
# ~2 months / 22k lines behind mobile-app/src (it still carried recipe copy
# fixed in #1830), capacitor.config.json had lost the PushNotifications block
# added in 2026-06-08, and capacitor.plugins.json read `[]` while the app
# declares push-notifications, browser and bluetooth-le. So the tracked copy
# was not "the latest" — it was a stale artifact that reads as source.
#
# Nothing enforced the refresh, and nothing realistically could: a committed
# bundle can only be gated by byte-diffing it against a fresh build, which
# #1467 proved impossible across OSes (sourcemap build paths + Rolldown
# nondeterminism). The repo already reached this same conclusion for the web
# bundle — public/m was untracked in #1470 and is built at deploy.
#
# The APK is unaffected: .github/workflows/android-build.yml runs
# `npm run build` then `npx cap sync android` before assembling, in BOTH the
# debug and release jobs, so CI regenerates all of this from source.
#
# Building locally in Android Studio now requires one command first:
#     cd mobile-app && npm run sync:android      # vite build + cap sync android
app/src/main/assets/public
app/src/main/assets/capacitor.config.json
app/src/main/assets/capacitor.plugins.json
app/src/main/res/xml/config.xml
